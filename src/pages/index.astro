---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import ResponsiveImage from '@components/ResponsiveImage.astro';
import TrustPoints from '@components/TrustPoints.astro';
import ServiceCard from '@components/ServiceCard.astro';
import FaqAccordion from '@components/FaqAccordion.astro';
import ReviewCard from '@components/ReviewCard.astro';
import CtaSection from '@components/CtaSection.astro';
import site from '@/lib/site';
import home from '@data/homepage.json';
import { getCollection } from 'astro:content';
import { localBusinessSchema } from '@/lib/schema';

const allServices = await getCollection('services', ({ data }) => data.published);
const featured = home.services.featuredSlugs
  .map((slug) => allServices.find((s) => s.data.urlSlug === slug))
  .filter(Boolean);

const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const areas = (await getCollection('serviceAreas', ({ data }) => data.published)).slice(0, 8);
const featuredReviews = (await getCollection('testimonials', ({ data }) => data.published && data.featured))
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder)
  .slice(0, 3);
---

<BaseLayout
  title="Jireh Cooler | South Florida Air Conditioning Experts"
  description="Family-operated, state-certified AC repair, installation, and maintenance in Broward and Palm Beach County since 1994. 24/7 emergency service."
  schema={localBusinessSchema()}
  preloadImage={home.hero.image}
>
  <!-- HERO -->
  <section class="hero-photo">
    <div class="hero-bg">
      <ResponsiveImage
        src={home.hero.image}
        alt={home.hero.imageAlt}
        ratio="16 / 9"
        mobileRatio="4 / 5"
        focal="22% 40%"
        variant="background"
        rounded={false}
        priority
        sizes="100vw"
      />
      <div class="hero-scrim" aria-hidden="true"></div>
    </div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow eyebrow-desktop">{home.hero.eyebrow}</p>
        <p class="eyebrow eyebrow-mobile">{home.hero.mobileEyebrow}</p>
        <h1>{home.hero.headline}</h1>
        <p class="hero-sub hero-sub-desktop">{home.hero.subheadline}</p>
        <p class="hero-sub hero-sub-mobile">{home.hero.mobileSubheadline}</p>
        <div class="hero-actions">
          <a href={home.hero.primaryCta.href} class="btn btn-primary btn-lg" data-track="phone_click" data-track-params={JSON.stringify({ location: "hero" })}>
            <Icon name="phone" class="icon-sm" />
            {home.hero.primaryCta.label}
          </a>
          <a href={home.hero.secondaryCta.href} class="btn btn-outline btn-lg" data-track="schedule_service_click" data-track-params={JSON.stringify({ location: "hero" })}>{home.hero.secondaryCta.label}</a>
        </div>
        <ul class="hero-facts hero-facts-desktop">
          <li><Icon name="shield" class="icon-sm" /> License {site.license.number}</li>
          <li><Icon name="clock" class="icon-sm" /> {site.emergencyAvailability} Emergency Service</li>
          <li><Icon name="calendar" class="icon-sm" /> Serving South Florida Since {site.foundedYear}</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- MOBILE TRUST STRIP (hero facts, moved out of the hero image area on small screens) -->
  <ul class="container trust-strip">
    <li><Icon name="shield" class="icon-sm" /> License {site.license.number}</li>
    <li><Icon name="clock" class="icon-sm" /> {site.emergencyAvailability} Emergency Service</li>
    <li><Icon name="calendar" class="icon-sm" /> {new Date().getFullYear() - site.foundedYear}+ Years of Experience</li>
  </ul>

  <!-- PATHWAYS -->
  <section class="pathways">
    <div class="container">
      <div class="section-head center">
        <h2>{home.pathways.heading}</h2>
      </div>
      <div class="pathway-grid">
        <a href={home.pathways.residential.href} class="pathway-card" data-reveal>
          <ResponsiveImage src={home.pathways.residential.image} alt={home.pathways.residential.imageAlt} ratio="16 / 10" variant="card" focal="center" />
          <div class="pathway-body">
            <h3>{home.pathways.residential.label}</h3>
            <p>{home.pathways.residential.description}</p>
            <span class="pathway-link">Explore Residential <Icon name="arrow-right" class="icon-xs" /></span>
          </div>
        </a>
        <a href={home.pathways.commercial.href} class="pathway-card" data-reveal style="transition-delay:80ms">
          <ResponsiveImage src={home.pathways.commercial.image} alt={home.pathways.commercial.imageAlt} ratio="16 / 10" variant="card" />
          <div class="pathway-body">
            <h3>{home.pathways.commercial.label}</h3>
            <p>{home.pathways.commercial.description}</p>
            <span class="pathway-link">Explore Commercial <Icon name="arrow-right" class="icon-xs" /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="section-royal trust-section">
    <div class="container trust-grid-layout">
      <div class="trust-media" data-reveal>
        <ResponsiveImage
          src={home.trust.image}
          alt={home.trust.imageAlt}
          ratio="5 / 4"
          mobileRatio="4 / 3"
          variant="editorial"
        />
      </div>
      <div class="trust-copy">
        <div class="section-head">
          <p class="eyebrow">{home.trust.eyebrow}</p>
          <h2>{home.trust.heading}</h2>
          <p>{home.trust.subheading}</p>
        </div>
        <TrustPoints points={home.trust.points} columns={2} />
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services-section">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">Complete AC Services</p>
        <h2>{home.services.heading}</h2>
        <p>{home.services.subheading}</p>
      </div>
      <div class="services-grid">
        {
          featured.map((service) => (
            <ServiceCard
              title={service!.data.title}
              description={service!.data.shortDescription}
              href={`/${service!.data.urlSlug}/`}
              icon={service!.data.icon}
            />
          ))
        }
      </div>
      <div class="services-cta">
        <a href="/services/" class="btn btn-outline">View All Services</a>
      </div>
    </div>
  </section>

  <!-- CUSTOMER STORIES -->
  <section class="reviews-teaser">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">Customer Stories</p>
        <h2>What Our Customers Say</h2>
      </div>
      {featuredReviews.length > 0 ? (
        <div class="reviews-grid">
          {featuredReviews.map((r) => (
            <ReviewCard
              reviewerName={r.data.reviewerName}
              rating={r.data.rating}
              reviewText={r.data.reviewText}
              reviewDate={r.data.reviewDate}
              sourceLabel={r.data.sourceLabel}
              sourceUrl={r.data.sourceUrl}
              featured
            />
          ))}
        </div>
      ) : (
        <p class="reviews-empty container-narrow">
          Real customer reviews are being added to this page. Visit our Google Business Profile for current, verified reviews in the meantime.
        </p>
      )}
      <div class="reviews-actions">
        <a href={site.googleProfileUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-track="google_reviews_click" data-track-params={JSON.stringify({ location: "homepage" })}>Read Our Reviews on Google</a>
      </div>
    </div>
  </section>

  <!-- EMERGENCY (full-bleed editorial photo, not another flat color block) -->
  <section class="emergency-section">
    <div class="emergency-bg">
      <ResponsiveImage src={home.emergency.image} alt={home.emergency.imageAlt} ratio="16 / 9" focal="50% 18%" variant="background" rounded={false} sizes="100vw" />
      <div class="emergency-scrim" aria-hidden="true"></div>
    </div>
    <div class="container emergency-inner" data-reveal>
      <p class="eyebrow">Emergency Service</p>
      <h2>{home.emergency.heading}</h2>
      <p>{home.emergency.description}</p>
      <div class="hero-actions">
        <a href={home.emergency.cta.href} class="btn btn-primary btn-lg" data-track="emergency_call_click" data-track-params={JSON.stringify({ location: "homepage_emergency" })}>
          <Icon name="bolt" class="icon-sm" />
          {home.emergency.cta.label}
        </a>
        <a href={home.emergency.href} class="btn btn-outline btn-lg">Learn More</a>
      </div>
    </div>
  </section>

  <!-- CLIENT TESTIMONIAL (compact video teaser — full video lives on /about/#client-testimonial) -->
  <section class="section-royal story-section">
    <div class="container story-inner" data-reveal>
      <span class="story-play" aria-hidden="true"><Icon name="play" class="icon-play" /></span>
      <p class="eyebrow">{home.clientTestimonial.eyebrow}</p>
      <h2>{home.clientTestimonial.heading}</h2>
      <p>{home.clientTestimonial.description}</p>
      <a href={home.clientTestimonial.cta.href} class="btn btn-white btn-lg" data-track="watch_testimonial_click" data-track-params={JSON.stringify({ location: "homepage" })}>{home.clientTestimonial.cta.label}</a>
    </div>
  </section>

  <!-- MORE WAYS WE HELP (compact cards — maintenance, financing, indoor air quality) -->
  <section class="section-ice more-help-section">
    <div class="container">
      <div class="section-head center">
        <h2>{home.moreWaysWeHelp.heading}</h2>
        <p>{home.moreWaysWeHelp.subheading}</p>
      </div>
      <div class="more-help-grid">
        {home.moreWaysWeHelp.cards.map((card) => (
          <div class="more-help-card" data-reveal>
            <span class="more-help-icon"><Icon name={card.icon} class="icon-md" /></span>
            <h3>{card.heading}</h3>
            <p>{card.description}</p>
            <a href={card.cta.href} class="more-help-link">{card.cta.label} <Icon name="arrow-right" class="icon-xs" /></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICE AREAS -->
  <section class="section-soft areas-section">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">Where We Work</p>
        <h2>Proudly Serving {site.serviceAreaSummary}</h2>
      </div>
      <ul class="areas-list">
        {areas.map((area) => (
          <li>
            <Icon name="pin" class="icon-sm" /> {area.data.city}
          </li>
        ))}
      </ul>
      <div class="services-cta">
        <a href="/service-areas/" class="btn btn-outline">View All Service Areas</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="container container-narrow">
      <div class="section-head center">
        <p class="eyebrow">Common Questions</p>
        <h2>Frequently Asked Questions</h2>
      </div>
      <FaqAccordion faqs={faqs.map((f) => f.data)} />
      <div class="services-cta">
        <a href="/faq/" class="btn btn-outline">View All FAQs</a>
      </div>
    </div>
  </section>

  <CtaSection
    heading={home.finalCta.heading}
    description={home.finalCta.description}
    primaryCta={home.finalCta.primaryCta}
    secondaryCta={home.finalCta.secondaryCta}
    backgroundImage={home.finalCta.backgroundImage}
    backgroundImageAlt={home.finalCta.backgroundImageAlt}
    layout="split"
  />
</BaseLayout>

<style>
  .hero-photo {
    position: relative;
    overflow: hidden;
    min-height: 520px;
    display: flex;
    align-items: center;
    /* Subtle angled lower edge — mobile/small-tablet only (see below), a
       bold branded panel rather than a plain rectangle. */
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 95%);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-bg :global(.rimg) {
    height: 100%;
    aspect-ratio: auto;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    /* Mobile default: a bold, on-brand royal-blue panel over the photo
       (lighter near the top so the office is still visible, strongly
       royal-blue toward the bottom where the text sits) rather than a
       generic dark tint. */
    background: linear-gradient(180deg, rgba(4, 54, 136, 0.32) 0%, rgba(4, 40, 92, 0.74) 45%, rgba(4, 23, 58, 0.94) 100%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    padding-block: var(--space-xl);
    display: flex;
    justify-content: center;
  }
  .hero-copy {
    max-width: 640px;
    text-align: center;
    margin-inline: auto;
  }
  .eyebrow-desktop,
  .hero-sub-desktop {
    display: none;
  }
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-white);
  }
  .hero-facts li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero-facts-desktop {
    display: none;
  }
  .trust-strip {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    list-style: none;
    padding-block: var(--space-md);
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }
  .trust-strip li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-royal);
  }
  @media (min-width: 720px) {
    .hero-photo {
      clip-path: none;
    }
    .hero-scrim {
      /* Tablet/desktop default: uniformly strong neutral scrim, since the
         stacked, nearly full-width copy column doesn't leave room to
         dodge the logo wall visible in the photo's left portion. */
      background: rgba(4, 14, 32, 0.78);
    }
    .hero-inner {
      justify-content: flex-start;
    }
    .hero-copy {
      max-width: 640px;
      text-align: left;
      margin-inline: 0;
    }
    .eyebrow-mobile,
    .hero-sub-mobile {
      display: none;
    }
    .eyebrow-desktop,
    .hero-sub-desktop {
      display: block;
    }
    .hero-facts-desktop {
      display: flex;
    }
    .trust-strip {
      display: none;
    }
  }
  @media (min-width: 1280px) {
    /* Only once the container reaches its own max-width is there enough
       spare room on the left for the copy column to fully clear the
       office's logo wall — swap to a left/right gradient so the logo
       stays visible instead of being flatly darkened. */
    .hero-scrim {
      background: linear-gradient(90deg, rgba(4, 20, 45, 0.28) 0%, rgba(4, 16, 36, 0.62) 45%, rgba(4, 12, 28, 0.92) 100%);
    }
    .hero-inner {
      justify-content: flex-end;
    }
  }
  .hero-copy .eyebrow {
    color: var(--color-cyan);
  }
  .hero-copy h1 {
    color: var(--color-white);
  }
  .hero-sub {
    font-size: var(--fs-md);
    max-width: 52ch;
    color: rgba(255, 255, 255, 0.86);
  }
  @media (max-width: 719px) {
    .hero-sub {
      margin-inline: auto;
    }
    .hero-inner {
      padding-block: var(--space-lg);
    }
    .hero-copy h1 {
      font-size: 40px;
      line-height: 1.08;
      max-width: 340px;
      margin-inline: auto;
      text-wrap: balance;
    }
  }
  @media (max-width: 599px) {
    .hero-copy h1 {
      font-size: 34px;
      max-width: 300px;
    }
  }
  @media (max-width: 389px) {
    .hero-copy h1 {
      font-size: 32px;
      max-width: 270px;
    }
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: var(--space-md);
  }
  @media (max-width: 719px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      margin-top: 20px;
      margin-bottom: 20px;
    }
    .hero-actions .btn {
      justify-content: center;
    }
  }
  .hero-photo .btn-outline {
    background: rgba(4, 54, 136, 0.35);
    border-color: rgba(255, 255, 255, 0.55);
    color: var(--color-white);
  }
  .hero-photo .btn-outline:hover {
    background: rgba(4, 54, 136, 0.55);
    border-color: var(--color-white);
  }
  .icon-sm {
    width: 18px;
    height: 18px;
  }
  .icon-xs {
    width: 15px;
    height: 15px;
  }

  .pathway-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
  }
  .pathway-card {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }
  .pathway-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .pathway-card:hover :global(img) {
    transform: scale(1.04);
  }
  .pathway-card :global(.rimg) {
    border-radius: 0;
  }
  .pathway-body {
    padding: var(--space-lg);
  }
  .pathway-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-royal);
  }

  .services-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr);
  }
  .services-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-xl);
  }

  .trust-grid-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: center;
  }
  .trust-copy .section-head {
    margin-bottom: var(--space-lg);
  }

  .emergency-section {
    position: relative;
    padding-block: var(--space-3xl);
    color: var(--color-white);
    overflow: hidden;
  }
  .emergency-bg {
    position: absolute;
    inset: 0;
  }
  .emergency-bg :global(.rimg) {
    height: 100%;
    aspect-ratio: auto;
  }
  /* Moyses' head sits near the top of the source photo; the section is much
     wider than it is tall, so object-fit: cover crops vertically. These
     overrides are tuned per breakpoint (not a single blind value) so his
     head and face stay fully in frame while the HVAC equipment on the left
     stays visible, across phone/tablet/1366px laptop/large desktop. */
  .emergency-bg :global(.rimg img) {
    object-position: 50% 22%;
  }
  @media (min-width: 640px) {
    .emergency-bg :global(.rimg img) {
      object-position: 50% 20%;
    }
  }
  @media (min-width: 1024px) {
    .emergency-bg :global(.rimg img) {
      object-position: 50% 18%;
    }
  }
  @media (min-width: 1440px) {
    .emergency-bg :global(.rimg img) {
      object-position: 50% 16%;
    }
  }
  .emergency-scrim {
    position: absolute;
    inset: 0;
    /* Brand royal blue (--color-royal: #043688) at low opacity — a light
       brand tint over the photo, not a dark scrim. */
    background: rgba(4, 54, 136, 0.2);
  }
  .emergency-inner {
    position: relative;
    z-index: 1;
    max-width: 620px;
  }
  .emergency-inner .eyebrow {
    color: var(--color-cyan);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }
  .emergency-inner h2 {
    color: var(--color-white);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
  }
  .emergency-inner p {
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
  }
  .emergency-inner .btn-outline {
    background: rgba(4, 54, 136, 0.35);
    border-color: rgba(255, 255, 255, 0.55);
    color: var(--color-white);
  }
  .emergency-inner .btn-outline:hover {
    background: rgba(4, 54, 136, 0.55);
    border-color: var(--color-white);
  }

  .story-inner {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .story-play {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-cyan);
    margin-bottom: var(--space-sm);
  }
  .icon-play {
    width: 28px;
    height: 28px;
  }
  .story-inner .eyebrow {
    color: var(--color-cyan);
  }
  .story-inner h2 {
    color: var(--color-white);
  }
  .story-inner p {
    color: rgba(255, 255, 255, 0.82);
    max-width: 48ch;
  }
  .story-inner .btn {
    margin-top: var(--space-sm);
  }

  .more-help-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
  }
  .more-help-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    box-shadow: var(--shadow-sm);
  }
  .more-help-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--color-ice);
    color: var(--color-royal);
    margin-bottom: var(--space-sm);
  }
  .icon-md {
    width: 22px;
    height: 22px;
  }
  .more-help-card p {
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }
  .more-help-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--fs-sm);
    color: var(--color-royal);
    margin-top: 0.4rem;
  }

  .reviews-teaser {
    text-align: center;
  }
  .reviews-grid {
    display: grid;
    align-items: start;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr);
    text-align: left;
    margin-bottom: var(--space-lg);
  }
  @media (min-width: 720px) {
    .reviews-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 960px) {
    .reviews-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .reviews-empty {
    color: var(--color-muted);
    margin-inline: auto;
    margin-bottom: var(--space-lg);
  }
  .reviews-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .areas-list {
    list-style: none;
    margin: 0 0 var(--space-lg);
