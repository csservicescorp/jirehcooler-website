---
interface Props {
  formType?: 'estimate' | 'contact';
  compact?: boolean;
}
const { formType = 'estimate', compact = false } = Astro.props;
const formName = formType === 'estimate' ? 'estimate-request' : 'contact';

const serviceOptions = [
  { value: 'ac-repair', label: 'AC Repair' },
  { value: 'ac-installation-and-replacement', label: 'AC Installation / Replacement' },
  { value: 'emergency-ac-service', label: 'Emergency Service' },
  { value: 'residential-hvac', label: 'Residential HVAC' },
  { value: 'commercial-hvac', label: 'Commercial HVAC' },
  { value: 'preventive-maintenance', label: 'Preventive Maintenance' },
  { value: 'maintenance-membership', label: 'V.I.P. Maintenance Membership' },
  { value: 'indoor-air-quality', label: 'Indoor Air Quality' },
  { value: 'duct-cleaning', label: 'Duct Cleaning' },
  { value: 'uv-light-systems', label: 'UV Light Systems' },
  { value: 'pool-heaters', label: 'Pool Heater' },
  { value: 'water-heaters', label: 'Water Heater' },
  { value: 'dryer-vent-cleaning', label: 'Dryer Vent Cleaning' },
  { value: 'smart-wifi-thermostats', label: 'Smart / Wi-Fi Thermostat' },
  { value: 'financing', label: 'Financing Question' },
  { value: 'other', label: 'Other' },
];
---

<form
  class="estimate-form"
  data-estimate-form
  novalidate
  name={formName}
  method="POST"
  action="/thank-you/"
  data-netlify="true"
  netlify-honeypot="companyWebsite"
>
  <input type="hidden" name="form-name" value={formName} />
  <!-- Honeypot field: hidden from real users, bots often fill every field -->
  <div class="hp-field" aria-hidden="true">
    <label for="company-website">Company Website</label>
    <input type="text" id="company-website" name="companyWebsite" tabindex="-1" autocomplete="off" />
  </div>
  <!-- Populated client-side with the page the visitor clicked from; never a UTM/tracking value. -->
  <input type="hidden" name="pageSource" data-page-source value="" />

  <div class="form-row">
    <div class="field">
      <label for="name">Full Name <span aria-hidden="true">*</span></label>
      <input type="text" id="name" name="name" required autocomplete="name" data-required aria-describedby="error-name" />
      <p class="field-error" id="error-name" data-error-for="name" role="alert" hidden></p>
    </div>
    <div class="field">
      <label for="phone">Phone Number <span aria-hidden="true">*</span></label>
      <input type="tel" id="phone" name="phone" required autocomplete="tel" inputmode="tel" data-required aria-describedby="error-phone" />
      <p class="field-error" id="error-phone" data-error-for="phone" role="alert" hidden></p>
    </div>
  </div>

  <div class="form-row">
    <div class="field">
      <label for="email">Email Address <span aria-hidden="true">*</span></label>
      <input type="email" id="email" name="email" required autocomplete="email" data-required aria-describedby="error-email" />
      <p class="field-error" id="error-email" data-error-for="email" role="alert" hidden></p>
    </div>
    <div class="field">
      <label for="zip">ZIP Code <span aria-hidden="true">*</span></label>
      <input type="text" id="zip" name="zip" inputmode="numeric" pattern="[0-9]{5}" required autocomplete="postal-code" data-required aria-describedby="error-zip" />
      <p class="field-error" id="error-zip" data-error-for="zip" role="alert" hidden></p>
    </div>
  </div>

  {formType === 'estimate' && (
    <div class="field">
      <label for="serviceNeeded">Service Needed <span aria-hidden="true">*</span></label>
      <select id="serviceNeeded" name="serviceNeeded" required data-required data-service-select aria-describedby="error-serviceNeeded">
        <option value="">Select a service</option>
        {serviceOptions.map((opt) => <option value={opt.value}>{opt.label}</option>)}
      </select>
      <p class="field-error" id="error-serviceNeeded" data-error-for="serviceNeeded" role="alert" hidden></p>
    </div>
  )}

  {formType === 'estimate' && (
    <fieldset class="field urgency-field">
      <legend>How Urgent Is This? <span aria-hidden="true">*</span></legend>
      <div class="urgency-options" role="radiogroup" aria-required="true" data-urgency-group aria-describedby="error-urgency">
        <label class="urgency-option">
          <input type="radio" name="urgency" value="emergency" required data-required />
          <span>Emergency</span>
        </label>
        <label class="urgency-option">
          <input type="radio" name="urgency" value="soon" />
          <span>Within a Few Days</span>
        </label>
        <label class="urgency-option">
          <input type="radio" name="urgency" value="planning" />
          <span>Planning Ahead</span>
        </label>
      </div>
      <p class="field-error" id="error-urgency" data-error-for="urgency" role="alert" hidden></p>
    </fieldset>
  )}

  <div class="field">
    <label for="message">
      {formType === 'estimate' ? 'Message or Project Details' : 'Message'}
      {formType !== 'estimate' && <span aria-hidden="true">*</span>}
    </label>
    <textarea
      id="message"
      name="message"
      rows={compact ? 3 : 4}
      required={formType !== 'estimate'}
      data-required={formType !== 'estimate'}
      placeholder={formType === 'estimate' ? "e.g. AC is blowing warm air, unit won't turn on..." : ''}
      aria-describedby="error-message"
    ></textarea>
    <p class="field-error" id="error-message" data-error-for="message" role="alert" hidden></p>
  </div>

  <div class="field consent-field">
    <label class="checkbox-label">
      <input type="checkbox" id="consent" name="consent" required data-required aria-describedby="error-consent" />
      <span>I agree to be contacted by Jireh Cooler by phone or email about my request. <span aria-hidden="true">*</span></span>
    </label>
    <p class="field-error" id="error-consent" data-error-for="consent" role="alert" hidden></p>
  </div>

  <button type="submit" class="btn btn-primary btn-lg btn-block" data-submit-btn>
    <span data-btn-label>{formType === 'estimate' ? 'Request My Estimate' : 'Send Message'}</span>
  </button>

  <noscript>
    <p class="noscript-note">
      If this form doesn't submit, please call us directly to reach our team.
    </p>
  </noscript>
</form>

<style>
  .estimate-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    min-width: 0;
  }
  .form-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md);
    min-width: 0;
  }
  .field {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem;
    min-width: 0;
    border: none;
    padding: 0;
    margin: 0;
  }
  .field label,
  .urgency-field legend {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-royal);
    padding: 0;
  }
  input,
  select,
  textarea {
    font-family: var(--font-body);
    font-size: var(--fs-base);
    padding: 0.85rem 0.9rem;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-charcoal);
    width: 100%;
    min-width: 0;
    min-height: 48px;
  }
  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--color-royal);
  }
  textarea {
    resize: vertical;
    min-height: unset;
  }
  .field.has-error input,
  .field.has-error select,
  .field.has-error textarea {
    border-color: var(--color-danger);
  }
  .field-error {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-danger);
  }
  .urgency-field {
    display: grid;
    gap: 0.5rem;
  }
  .urgency-options {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
  }
  .urgency-option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    min-height: 48px;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    font-weight: 600;
    color: var(--color-charcoal);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }
  .urgency-option input {
    width: auto;
    min-height: unset;
    accent-color: var(--color-royal);
  }
  .urgency-option:has(input:checked) {
    border-color: var(--color-royal);
    background: var(--color-ice);
    color: var(--color-royal);
  }
  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: var(--fs-sm);
    color: var(--color-muted);
    cursor: pointer;
  }
  .checkbox-label input {
    width: auto;
    min-height: unset;
    margin-top: 0.2rem;
  }
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .noscript-note {
    font-size: var(--fs-sm);
    color: var(--color-danger);
  }
  [data-submit-btn][disabled] {
    opacity: 0.7;
    cursor: not-allowed;
  }
  .btn-block {
    width: 100%;
    min-height: 52px;
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .urgency-options {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('[data-estimate-form]');

  function trackEvent(name: string, params: Record<string, unknown> = {}) {
    const w = window as unknown as { gtag?: (...args: unknown[]) => void };
    if (typeof w.gtag === 'function') w.gtag('event', name, params);
  }

  forms.forEach((form) => {
    // Preselect the service dropdown from ?service=<slug> on the estimate form.
    const serviceSelect = form.querySelector<HTMLSelectElement>('[data-service-select]');
    if (serviceSelect) {
      const params = new URLSearchParams(window.location.search);
      const requested = params.get('service');
      if (requested && [...serviceSelect.options].some((o) => o.value === requested)) {
        serviceSelect.value = requested;
      }
    }

    // Record which page the visitor was on when they reached this form: the
    // referring page for a dedicated form page (e.g. a CTA on the homepage
    // linking to /request-an-estimate/), or the current page itself when the
    // form is embedded inline (e.g. the Contact page's own form, where no
    // navigation happens between the click and the form).
    const pageSourceInput = form.querySelector<HTMLInputElement>('[data-page-source]');
    if (pageSourceInput) {
      let source = window.location.pathname;
      try {
        if (document.referrer) {
          const referrer = new URL(document.referrer);
          if (referrer.origin === window.location.origin && referrer.pathname !== window.location.pathname) {
            source = referrer.pathname;
          }
        }
      } catch {
        /* malformed referrer, fall back to the current page path */
      }
      pageSourceInput.value = source;
    }

    let started = false;
    form.addEventListener(
      'input',
      () => {
        if (!started) {
          started = true;
          trackEvent('estimate_form_start');
        }
      },
      { once: true }
    );

    function clearErrors() {
      form.querySelectorAll<HTMLElement>('.field-error').forEach((el) => {
        el.hidden = true;
        el.textContent = '';
      });
      form.querySelectorAll<HTMLElement>('.field.has-error, .urgency-field.has-error').forEach((el) => {
        el.classList.remove('has-error');
      });
      form.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((el) => el.setAttribute('aria-invalid', 'false'));
    }

    function showError(name: string, message: string) {
      const errorEl = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = false;
      const container = errorEl.closest('.field') ?? errorEl.closest('.urgency-field');
      container?.classList.add('has-error');
      container?.querySelectorAll<HTMLElement>(`[name="${name}"]`).forEach((el) => el.setAttribute('aria-invalid', 'true'));
    }

    function validate(): boolean {
      clearErrors();
      let firstInvalid: HTMLElement | null = null;
      let valid = true;

      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[data-required]').forEach((field) => {
        if (field.type === 'radio') {
          const group = form.querySelectorAll<HTMLInputElement>(`input[name="${field.name}"]`);
          const checked = [...group].some((r) => r.checked);
          if (!checked) {
            valid = false;
            showError('urgency', 'Please select one.');
            firstInvalid ??= group[0];
          }
          return;
        }
        if (field.type === 'checkbox' && !(field as HTMLInputElement).checked) {
          valid = false;
          showError(field.name, 'Required to submit this form.');
          firstInvalid ??= field;
          return;
        }
        if (field.type !== 'checkbox' && !field.value.trim()) {
          valid = false;
          showError(field.name, 'This field is required.');
          firstInvalid ??= field;
          return;
        }
        if (field.name === 'zip' && field.value.trim() && !/^\d{5}$/.test(field.value.trim())) {
          valid = false;
          showError('zip', 'Enter a 5-digit ZIP code.');
          firstInvalid ??= field;
        }
      });

      const email = form.querySelector<HTMLInputElement>('#email');
      if (email && email.value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
        valid = false;
        showError('email', 'Enter a valid email address.');
        firstInvalid ??= email;
      }

      if (firstInvalid) firstInvalid.focus();
      return valid;
    }

    form.addEventListener('submit', (e) => {
      // Validation only ever blocks submission on error. When the form is
      // valid, no preventDefault is called at all — the browser performs a
      // normal native POST to Netlify (action="/thank-you/"), which is what
      // lets Netlify Forms' own static detection, honeypot check, and
      // notification pick up every real field exactly as submitted.
      if (!validate()) {
        e.preventDefault();
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('[data-submit-btn]');
      if (button) button.disabled = true; // guards against a duplicate click while the page navigates away

      trackEvent('estimate_form_submit', { form_type: form.getAttribute('name') ?? 'estimate' });
    });
  });
</script>
