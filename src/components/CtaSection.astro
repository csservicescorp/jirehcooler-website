---
import site from '@/lib/site';
import ResponsiveImage from './ResponsiveImage.astro';

interface Cta {
  label: string;
  href: string;
}
interface Props {
  heading: string;
  description?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  variant?: 'navy' | 'ice';
  backgroundImage?: string;
  backgroundImageAlt?: string;
  backgroundFocal?: string;
  backgroundMobileFocal?: string;
  /** 'split' renders a two-column premium layout (copy left, uncropped photo
   * right) instead of the default full-bleed background-photo treatment.
   * Opt-in only — every other caller of CtaSection is unaffected. */
  layout?: 'default' | 'split';
}
const {
  heading,
  description,
  primaryCta = { label: 'Call Now', href: `tel:${site.phoneRaw}` },
  secondaryCta = { label: 'Request an Estimate', href: '/request-an-estimate/#estimate-request' },
  variant = 'navy',
  backgroundImage,
  backgroundImageAlt = '',
  backgroundFocal = 'center',
  backgroundMobileFocal,
  layout = 'default',
} = Astro.props;
const isSplit = layout === 'split' && !!backgroundImage;
---

{isSplit ? (
  <section class="final-cta split-cta section-royal" data-reveal>
    <div class="split-inner">
      <div class="split-copy">
        <h2>{heading}</h2>
        {description && <p>{description}</p>}
        <div class="cta-actions">
          <a href={primaryCta.href} class="btn btn-lg btn-white">{primaryCta.label}</a>
          <a href={secondaryCta.href} class="btn btn-lg btn-outline">{secondaryCta.label}</a>
        </div>
      </div>
      <div class="split-media">
        <ResponsiveImage
          src={backgroundImage}
          alt={backgroundImageAlt}
          ratio="4 / 5"
          mobileRatio="4 / 5"
          variant="editorial"
          fit="contain"
          rounded={false}
        />
      </div>
    </div>
  </section>
) : (
  <section
    class:list={['final-cta', variant === 'navy' ? 'section-royal' : 'section-ice', { 'has-bg': !!backgroundImage }]}
    data-reveal
  >
    {backgroundImage && (
      <div class="cta-bg">
        <ResponsiveImage
          src={backgroundImage}
          alt={backgroundImageAlt}
          ratio="16 / 9"
          variant="background"
          rounded={false}
          focal={backgroundFocal}
          mobileFocal={backgroundMobileFocal}
        />
        <div class="cta-scrim" aria-hidden="true"></div>
      </div>
    )}
    <div class="container cta-inner">
      <div class="cta-copy">
        <h2>{heading}</h2>
        {description && <p>{description}</p>}
      </div>
      <div class="cta-actions">
        <a href={primaryCta.href} class:list={['btn', 'btn-lg', variant === 'navy' ? 'btn-white' : 'btn-primary']}>
          {primaryCta.label}
        </a>
        <a href={secondaryCta.href} class="btn btn-lg btn-outline">{secondaryCta.label}</a>
      </div>
    </div>
  </section>
)}

<style>
  .final-cta {
    position: relative;
    border-radius: var(--radius-lg);
    max-width: calc(var(--content-max) - 2 * var(--space-md));
    margin-inline: auto;
    overflow: hidden;
  }
  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .cta-bg :global(.rimg) {
    height: 100%;
    aspect-ratio: auto;
  }
  .cta-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(4, 20, 45, 0.62) 0%, rgba(4, 20, 45, 0.4) 45%, rgba(4, 20, 45, 0.22) 100%);
  }
  @media (max-width: 719px) {
    .cta-scrim {
      background: rgba(4, 20, 45, 0.58);
    }
  }
  .has-bg .cta-copy h2 {
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
  }
  .has-bg .cta-copy p {
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
  }
  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    align-items: flex-start;
    justify-content: space-between;
  }
  .cta-copy h2 {
    max-width: 22ch;
  }
  .cta-copy p {
    max-width: 55ch;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 860px) {
    .cta-inner {
      flex-direction: row;
      align-items: center;
    }
  }

  /* Split layout (homepage final CTA only): the source photo is a vertical
     portrait, so instead of forcing object-fit: cover on a wide banner (which
     hid almost the whole photo), it gets its own contained panel at full,
     honest proportions — no crop, no overlay on the face. */
  .split-cta {
    padding: 0;
  }
  .split-inner {
    display: flex;
    flex-direction: column;
  }
  .split-copy {
    position: relative;
    z-index: 1;
    padding: var(--space-xl) var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }
  .split-copy h2 {
    color: var(--color-white);
    max-width: 22ch;
  }
  .split-copy p {
    color: rgba(255, 255, 255, 0.88);
    max-width: 48ch;
  }
  .split-media {
    width: 100%;
    aspect-ratio: 4 / 5;
  }
  .split-media :global(.rimg) {
    width: 100%;
    height: 100%;
    background: transparent;
  }

  @media (min-width: 860px) {
    .split-inner {
      flex-direction: row;
      align-items: stretch;
      min-height: 360px;
    }
    .split-copy {
      width: 55%;
      justify-content: center;
      padding: var(--space-xl) var(--space-2xl);
    }
    .split-media {
      width: 45%;
      aspect-ratio: auto;
    }
  }
  @media (min-width: 1280px) {
    .split-inner {
      min-height: 430px;
    }
  }
</style>
